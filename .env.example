DATABASE_URL="file:./dev.db"
STUDIO_ENABLED="true"
NEXT_TELEMETRY_DISABLED="1"

# Set this in the Git-ignored .env.local for local use; restart Next.js after changes.
# Optional public, referrer-restricted Esri browser key. Leave blank for regional open-data search.
# Review service pricing and configure account usage limits before enabling paid services.
NEXT_PUBLIC_ARCGIS_API_KEY=""

# Server-only staff credentials; configure .env.local, never commit secrets.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_REMOTE_ENABLED="false"
ADMIN_ORIGIN=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-6-luna"
OPENAI_PROJECT_ID=""
AI_DAILY_CALL_LIMIT="5"
AI_DAILY_TOKEN_LIMIT="250000"
# Optional verified account rates for cost estimates; blank means unknown.
OPENAI_INPUT_USD_PER_MILLION=""
OPENAI_OUTPUT_USD_PER_MILLION=""
